{
  "title": "BAS MCP Monitor",
  "uid": "bas-mcp-001",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Log Stream",
      "type": "logs",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 8 },
      "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
      "targets": [
        {
          "expr": "{service=\"bas-mcp\"}",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 2,
      "title": "Errors & Warnings",
      "type": "logs",
      "gridPos": { "x": 0, "y": 8, "w": 24, "h": 6 },
      "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
      "targets": [
        {
          "expr": "{service=\"bas-mcp\"} | json | level=~\"error|warning\"",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 3,
      "title": "Input Tokens per Request",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 14, "w": 12, "h": 7 },
      "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
      "targets": [
        {
          "expr": "sum by (component) (sum_over_time({service=\"bas-mcp\"} | json | event=\"claude_response\" | unwrap input_tokens [1m]))",
          "refId": "A",
          "legendFormat": "input {{component}}"
        },
        {
          "expr": "sum by (component) (sum_over_time({service=\"bas-mcp\"} | json | event=\"claude_response\" | unwrap output_tokens [1m]))",
          "refId": "B",
          "legendFormat": "output {{component}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "id": 4,
      "title": "Tool Calls",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 14, "w": 12, "h": 7 },
      "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
      "targets": [
        {
          "expr": "sum by (tool) (count_over_time({service=\"bas-mcp\"} | json | event=\"mcp_tool_call\" [1m]))",
          "refId": "A",
          "legendFormat": "{{tool}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "id": 5,
      "title": "Tool Call Rate (last 1h)",
      "type": "barchart",
      "gridPos": { "x": 0, "y": 21, "w": 12, "h": 7 },
      "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
      "targets": [
        {
          "expr": "sum by (tool) (count_over_time({service=\"bas-mcp\"} | json | event=\"mcp_tool_call\" [1h]))",
          "refId": "A",
          "legendFormat": "{{tool}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Error Rate",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 21, "w": 12, "h": 7 },
      "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
      "targets": [
        {
          "expr": "sum(count_over_time({service=\"bas-mcp\"} | json | level=\"error\" [1m]))",
          "refId": "A",
          "legendFormat": "errors"
        },
        {
          "expr": "sum(count_over_time({service=\"bas-mcp\"} | json | level=\"warning\" [1m]))",
          "refId": "B",
          "legendFormat": "warnings"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" }
        }
      }
    }
  ]
}

