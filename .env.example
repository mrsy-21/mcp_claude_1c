# Telegram
TELEGRAM_BOT_TOKEN=

# Logging
LOG_FORMAT=console       # console (dev) або json (prod/docker)
LOG_LEVEL=INFO
LOG_DIR=logs

# LLM
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Groq (резерв)
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# 1С OData
ODATA_BASE_URL=http://IP/BaseName/odata/standard.odata
ODATA_USER=
ODATA_PASSWORD=

# FastAPI
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
FASTAPI_URL=http://localhost:8000

# Entity whitelist для MCP tools (через кому, підтримує wildcard *)
BAS_ENTITY_WHITELIST=Document_СчетНаОплату,Document_АктВыполненныхРабот,Catalog_Контрагенты
